# Database configuration
DATABASE_URL=postgresql+psycopg://kote@localhost:5432/creator_marketplace

# JWT Security
SECRET_KEY=change-this-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional YouTube Data API v3 key. Required only for YouTube account syncing.
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT_SECONDS=10

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
