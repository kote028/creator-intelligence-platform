# Database configuration
DATABASE_URL=postgresql+psycopg://kote@localhost:5432/creator_marketplace

# JWT Security
SECRET_KEY=change-this-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional YouTube Data API v3 key. Required only for YouTube account syncing.
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT_SECONDS=10

# Optional Google Identity Services OAuth client ID (configure in Google Cloud Console).
GOOGLE_CLIENT_ID=

# Optional OpenAI Responses API integration for grounded marketplace answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=20

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
